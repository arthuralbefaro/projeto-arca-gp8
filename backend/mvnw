# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup batch script, version 3.3.2
# ----------------------------------------------------------------------------

set -e

findMavenWrapper() {
  SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
  while true; do
    if [ -f "$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.jar" ] || [ -f "$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.properties" ]; then
      echo "$SCRIPT_DIR"
      return
    fi
    parent="$(dirname "$SCRIPT_DIR")"
    if [ "$parent" = "$SCRIPT_DIR" ]; then
      echo "Could not find .mvn/wrapper directory" >&2
      exit 1
    fi
    SCRIPT_DIR="$parent"
  done
}

BASE_DIR=$(findMavenWrapper)
MAVEN_PROJECTBASEDIR="$BASE_DIR"
export MAVEN_PROJECTBASEDIR

MAVEN_WRAPPER_PROPERTIES="$BASE_DIR/.mvn/wrapper/maven-wrapper.properties"

if [ -f "$MAVEN_WRAPPER_PROPERTIES" ]; then
  DISTRIBUTION_URL=$(grep distributionUrl "$MAVEN_WRAPPER_PROPERTIES" | cut -d= -f2-)
  WRAPPER_URL=$(grep wrapperUrl "$MAVEN_WRAPPER_PROPERTIES" | cut -d= -f2-)
fi

MAVEN_USER_HOME="${MAVEN_USER_HOME:-$HOME/.m2}"
MAVEN_WRAPPER_DIR="$MAVEN_USER_HOME/wrapper/dists"

distributionFileName="${DISTRIBUTION_URL##*/}"
distributionVersion="${distributionFileName%-bin.zip}"
distributionDir="$MAVEN_WRAPPER_DIR/$distributionVersion"

if [ ! -d "$distributionDir" ]; then
  mkdir -p "$distributionDir"
  echo "Downloading Maven from $DISTRIBUTION_URL"
  if command -v curl > /dev/null 2>&1; then
    curl -fsSL "$DISTRIBUTION_URL" -o "$distributionDir/maven.zip"
  elif command -v wget > /dev/null 2>&1; then
    wget -q "$DISTRIBUTION_URL" -O "$distributionDir/maven.zip"
  else
    echo "Neither curl nor wget found" >&2
    exit 1
  fi
  unzip -q "$distributionDir/maven.zip" -d "$distributionDir"
  rm "$distributionDir/maven.zip"
fi

MAVEN_HOME="$distributionDir/$distributionVersion"
export MAVEN_HOME

exec "$MAVEN_HOME/bin/mvn" "$@"
