# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_BASE_PATH=
# Modo demonstração estático (sem backend). Use true para GitHub Pages / Figma.
NEXT_PUBLIC_MOCK_MODE=false

# Backend
DATABASE_URL=jdbc:postgresql://localhost:5432/arca_db
DATABASE_USER=arca_user
DATABASE_PASS=arca_demo_pass
JWT_SECRET=demo-only-change-before-production-32-bytes-minimum
JWT_ISSUER=arca-api
JWT_AUDIENCE=arca-admin
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=28800000
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=Lax
